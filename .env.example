# ==============================================================================
# Sony BRAVIA XR-65X90J Suite — Environment Configuration Template
# Copy this file to .env and configure for your local network environment.
# ==============================================================================

# Primary override for TV IP endpoint (optional: auto-detected if empty)
# SONY_TV_IP=192.168.1.100

# Dual-Homed Network Interface Configurations
SONY_TV_WIFI_IP=192.168.1.100
SONY_TV_WIFI_MAC=38:B8:00:XX:XX:XX

SONY_TV_LAN_IP=10.42.0.100
SONY_TV_LAN_MAC=F8:4E:17:XX:XX:XX

# Sony WebAPI Pre-Shared Key (Configured on TV under Network -> IP Control -> Pre-Shared Key)
SONY_TV_PSK=YOUR_PSK_HERE

# Path to persistent Netscape session cookie jar (default: config/cookies.txt)
SONY_TV_COOKIE_FILE=config/cookies.txt

# Elevated ADB target in host:port format (optional: auto-detected if empty)
SONY_TV_ADB=192.168.1.100:5555
